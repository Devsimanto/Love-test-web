rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/{docId} {
      allow get: if true;
    }

    match /letters/{letterId} {
      // Direct access with unique letter ID is allowed
      allow get: if true;
      allow list: if false;
      
      // Anyone can create a letter with matching id
      allow create: if request.resource.data.id == letterId;
      
      // Updates allowed for real-time clicks and events
      allow update: if true;
      allow delete: if false;
    }
  }
}
